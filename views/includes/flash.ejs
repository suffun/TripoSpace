<% if (messages && messages.length > 0) { %>
  <div class="container mt-3">
    <% messages.forEach(msg => { %>
      <div class="alert alert-<%= msg.type %> alert-dismissible fade show mx-auto col-md-6" role="alert">
        <%= msg.message %>
        <button 
          type="button" 
          class="btn-close" 
          data-bs-dismiss="alert" 
          aria-label="Close">
        </button>
      </div>
    <% }) %>
  </div>
<% } %>
