<% if (success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show col-md-8 offset-md-2 col-12 mt-3 shadow-sm rounded-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= success[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show col-md-8 offset-md-2 col-12 mt-3 shadow-sm rounded-4" role="alert">
    <i class="fa-solid fa-circle-exclamation me-2"></i> <%= error[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<% if (warning && warning.length) { %>
  <div class="alert alert-warning alert-dismissible fade show col-md-8 offset-md-2 col-12 mt-3 shadow-sm rounded-4" role="alert">
    <i class="fa-solid fa-triangle-exclamation me-2"></i> <%= warning[0] %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

