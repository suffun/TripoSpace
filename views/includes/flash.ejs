<% if (messages && messages.length > 0) { %>
  <% messages.forEach(msg => { %>
    <div class="alert alert-<%= msg.type %> alert-dismissible fade show col-6 offset-3" role="alert">
      <%= msg.message %>

      <button 
        type="button" 
        class="btn-close" 
        data-bs-dismiss="alert" 
        aria-label="Close">
      </button>
    </div>
  <% }) %>
<% } %>
