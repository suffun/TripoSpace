<nav class="navbar navbar-expand-md navbar-custom sticky-top">
  <div class="container-fluid px-lg-4 px-2 position-relative">
    <!-- Brand Logo -->
    <a class="brand-logo" href="/listings">
      <i class="fa-solid fa-compass"></i>
      <span>TripoSpace</span>
    </a>

    <!-- Center Search Bar (Dead Center on Desktop) -->
    <div class="nav-search-center-container d-none d-md-block">
      <form class="nav-search-bar" action="/listings" method="GET" role="search">
        <input
          class="nav-search-input"
          type="text"
          name="search"
          placeholder="Search destinations, stays..."
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          aria-label="Search"
        />
        <button class="nav-search-btn" type="submit" aria-label="Search button">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <!-- Mobile Quick Right Controls: Fast Theme Toggle + Hamburger Toggler -->
    <div class="d-flex align-items-center gap-2 d-md-none">
      <button class="theme-toggle-btn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <i class="fa-solid fa-moon"></i>
      </button>
      <button
        class="navbar-toggler border-0 shadow-none p-1"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarContent"
        aria-controls="navbarContent"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <i class="fa-solid fa-bars fs-3"></i>
      </button>
    </div>

    <!-- Collapsible Menu Container -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <!-- 1. Desktop Nav Layout (hidden on mobile) -->
      <div class="navbar-nav ms-auto align-items-center gap-2 d-none d-md-flex">
        <!-- Explore Link -->
        <a class="nav-action-btn" href="/listings">Explore</a>

        <!-- Become a Host Link -->
        <a class="nav-action-btn" href="/listings/new">Become a host</a>

        <!-- Wishlist Icon Link -->
        <a class="nav-circle-btn" href="/wishlist" title="Wishlist" aria-label="Wishlist">
          <i class="fa-regular fa-heart"></i>
        </a>

        <!-- Dark Mode Toggle Button (Desktop) -->
        <button id="themeToggleBtn" class="theme-toggle-btn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <i class="fa-solid fa-moon"></i>
        </button>

        <!-- User Menu Dropdown -->
        <div class="dropdown ms-1">
          <button
            class="user-menu-pill dropdown-toggle text-decoration-none"
            type="button"
            id="userDropdownMenu"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <i class="fa-solid fa-bars text-muted" style="font-size: 0.9rem;"></i>
            <% if (currUser) { %>
              <div class="user-avatar-circle">
                <%= currUser.username ? currUser.username[0].toUpperCase() : 'U' %>
              </div>
            <% } else { %>
              <i class="fa-solid fa-circle-user fs-4 text-muted"></i>
            <% } %>
          </button>

          <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 p-2" aria-labelledby="userDropdownMenu" style="min-width: 220px;">
            <% if (!currUser) { %>
              <li><a class="dropdown-item py-2 fw-semibold rounded-3" href="/signup"><i class="fa-solid fa-user-plus me-2 text-primary"></i> Sign up</a></li>
              <li><a class="dropdown-item py-2 rounded-3" href="/login"><i class="fa-solid fa-right-to-bracket me-2 text-muted"></i> Log in</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item py-2 rounded-3 text-muted" href="/listings/new">Host your home</a></li>
            <% } else { %>
              <li class="px-3 py-2 text-muted small">Logged in as <b class="text-dark"><%= currUser.username %></b></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item py-2 rounded-3" href="/wishlist"><i class="fa-regular fa-heart me-2 text-danger"></i> My Wishlist</a></li>
              <li><a class="dropdown-item py-2 rounded-3" href="/listings/new"><i class="fa-solid fa-plus me-2 text-muted"></i> Add New Stay</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item py-2 rounded-3 text-danger fw-semibold" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Log out</a></li>
            <% } %>
          </ul>
        </div>
      </div>

      <!-- 2. Mobile Nav Drawer Layout (hidden on desktop) -->
      <div class="mobile-nav-drawer d-md-none pt-2 pb-1">
        <!-- Mobile Search Form -->
        <div class="mb-3 px-1">
          <form class="nav-search-bar w-100" action="/listings" method="GET" role="search">
            <input
              class="nav-search-input"
              type="text"
              name="search"
              placeholder="Search destinations, stays..."
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              aria-label="Search destinations"
            />
            <button class="nav-search-btn" type="submit" aria-label="Search button">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </form>
        </div>

        <!-- Mobile Navigation Links -->
        <div class="mobile-nav-links d-flex flex-column gap-1">
          <a class="mobile-nav-item" href="/listings">
            <i class="fa-solid fa-compass text-primary me-3"></i>
            <span>Explore Stays</span>
          </a>

          <a class="mobile-nav-item" href="/listings/new">
            <i class="fa-solid fa-house-chimney-user text-primary me-3"></i>
            <span>Become a Host</span>
          </a>

          <a class="mobile-nav-item" href="/wishlist">
            <i class="fa-solid fa-heart text-danger me-3"></i>
            <span>My Wishlist</span>
          </a>

          <hr class="mobile-nav-divider my-2">

          <!-- User Account Info on Mobile -->
          <% if (!currUser) { %>
            <div class="d-flex gap-2 pt-2 px-1">
              <a href="/login" class="btn btn-outline-dark rounded-pill flex-fill py-2 fw-semibold">Log in</a>
              <a href="/signup" class="btn btn-primary rounded-pill flex-fill py-2 fw-semibold">Sign up</a>
            </div>
          <% } else { %>
            <div class="mobile-user-card p-3 rounded-4 mb-1">
              <div class="d-flex align-items-center gap-3 mb-2">
                <div class="user-avatar-circle">
                  <%= currUser.username ? currUser.username[0].toUpperCase() : 'U' %>
                </div>
                <div>
                  <div class="fw-bold"><%= currUser.username %></div>
                  <small class="text-muted"><%= currUser.email || 'TripoSpace Traveler' %></small>
                </div>
              </div>
              <div class="d-flex flex-column gap-1 mt-2 pt-2 border-top">
                <a class="mobile-nav-subitem" href="/listings/new">
                  <i class="fa-solid fa-plus me-2 text-muted"></i> Add New Stay
                </a>
                <a class="mobile-nav-subitem text-danger fw-semibold" href="/logout">
                  <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Log out
                </a>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</nav>