<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/style.css">

<div class="form-container">
  <h3>Create a New Listing</h3>

  <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
    <label for="title">Title</label>
    <input
      id="title"
      name="listing[title]"
      type="text"
      placeholder="Enter title"
      class="form-control was-validated"
      required
    />
    <div class="invalid-feedback">please enter a title</div>

    <label for="desc">Description</label>
    <textarea
      id="desc"
      name="listing[description]"
      placeholder="Enter description"
      class="form-control was-validated"
      required
    ></textarea>
    <div class="invalid-feedback">please enter a short description</div>

       <label for="image">Upload Image</label>
    <input
      id="image"
      name="listing[image]"
      type="file"
    />

    <label for="price">Price (₹)</label>
    <input
      id="price"
      name="listing[price]"
      type="number"
      placeholder="Enter price"
      class="form-control was-validated"
      required
    />
    <div class="invalid-feedback">please enter a correct price</div>

    <label for="country">Country</label>
    <input
      id="country"
      name="listing[country]"
      type="text"
      placeholder="Enter country"
      class="form-control was-validated"
      required
    />
    <div class="invalid-feedback">please enter a country name</div>

    <label for="location">Location</label>
    <input
      id="location"
      name="listing[location]"
      type="text"
      placeholder="Enter location"
      class="form-control was-validated"
      required
    />
    <div class="invalid-feedback"> enter location</div>

    <button type="submit">Add Listing</button>
  </form>
</div>
