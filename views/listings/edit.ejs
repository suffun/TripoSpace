<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/style.css" />

<div class="edit-wrapper">
  <div class="edit-container">
    <h3>Edit Listing</h3>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <label>Title</label>
      <input
        name="listing[title]"
        value="<%= listing.title %>"
        type="text"
        placeholder="Enter title"
        required
        class="form-control"
      />
      <div class="invalid-feedback">please enter a title</div>

      <label>Description</label>
      <textarea
        name="listing[description]"
        placeholder="Enter description"
        required
        class="form-control"
      >
<%= listing.description %></textarea
      >
      <div class="invalid-feedback">please enter a short description</div>

      <div class="mb-3">
        <p class="form-label">Original Listing Image</p>
        <div class="original-img-preview">
          <img src="<%= originalImageUrl %>" class="img-thumbnail" />
        </div>
      </div>

      <label>Upload New image</label>
      <input
        name="listing[image]"
        type="file"
        placeholder="Enter image URL"
        class="form-control"
      />

      <label>Price (₹)</label>
      <input
        name="listing[price]"
        value="<%= listing.price %>"
        type="number"
        placeholder="Enter price"
        required
        class="form-control"
      />
      <div class="invalid-feedback">please enter a correct price</div>

      <label>Country</label>
      <input
        name="listing[country]"
        value="<%= listing.country %>"
        type="text"
        placeholder="Enter country"
        required
        class="form-control"
      />
      <div class="invalid-feedback">please enter a country name</div>

      <label>Location</label>
      <input
        name="listing[location]"
        value="<%= listing.location %>"
        type="text"
        placeholder="Enter location"
        required
        class="form-control"
      />
      <div class="invalid-feedback">please enter location</div>
      <button type="submit">Update Listing</button>
    </form>
  </div>
</div>
