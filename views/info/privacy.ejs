<% layout("/layouts/boilerplate") %>

<div class="container py-5" style="max-width: 800px;">
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
    <h1 class="fw-bold mb-3">Privacy Policy</h1>
    <p class="text-muted">Last updated: September 2026</p>
    <hr class="my-4">
    
    <h4 class="fw-bold mt-3 mb-2">1. Information We Collect</h4>
    <p class="text-muted">TripoSpace collects information you provide directly to us when creating an account, publishing a listing, booking accommodation, or contacting our support team. This includes your name, email, credentials, and property information.</p>

    <h4 class="fw-bold mt-4 mb-2">2. How We Use Your Information</h4>
    <p class="text-muted">We use the information we collect to operate, improve, and personalize our travel accommodation platform, facilitate reservations, verify identities, and prevent fraudulent activity.</p>

    <h4 class="fw-bold mt-4 mb-2">3. Data Security</h4>
    <p class="text-muted">We implement industry-standard encryption, password hashing, and secure server protocols to protect your personal information.</p>

    <div class="mt-4">
      <a href="/listings" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Explore
      </a>
    </div>
  </div>
</div>
